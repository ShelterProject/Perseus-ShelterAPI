# Copy this file to `.env` for local runs. `.env` is gitignored — never commit
# real values. In GitHub Actions / Cloudflare, set these as encrypted Secrets
# instead (Settings > Secrets and variables), not as plain workflow env vars.

# NASA FIRMS — free self-service key, https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# Cloudflare — used by the pipeline to write into D1, and by wrangler to deploy the Worker
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=

# Firebase Cloud Messaging — for the "Notified" step (push notifications on extreme predictions)
FCM_SERVER_KEY=
