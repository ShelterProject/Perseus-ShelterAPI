# Copy this file to `.env` for local runs. `.env` is gitignored — never commit
# real values. In GitHub Actions / Cloudflare, set these as encrypted Secrets
# instead (Settings > Secrets and variables), not as plain workflow env vars.

# NASA FIRMS — free self-service key, https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# PostgreSQL (Aiven) — from the service's Overview tab in the Aiven dashboard.
# Aiven requires verified TLS (sslmode=verify-ca); PG_CA_CERT is the full
# multi-line "CA certificate" text, pasted as-is (including the BEGIN/END lines).
PG_HOST=
PG_PORT=
PG_USER=
PG_PASSWORD=
PG_DATABASE=
PG_CA_CERT=

# Cloudflare — used by wrangler to create Hyperdrive and deploy the Worker
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
HYPERDRIVE_ID=

# Firebase Cloud Messaging — for the "Notified" step (push notifications on extreme predictions)
FCM_SERVER_KEY=
