name = "perseus-shelter-api"
main = "src/index.ts"
compatibility_date = "2025-01-01"
compatibility_flags = ["nodejs_compat"]

# Koneksi Postgres TCP langsung dari Worker (socket mentah, nodejs_compat)
# gak reliable -- TLS handshake-nya suka retry-storm kena limit subrequest
# Workers. Pakai Hyperdrive: Worker cuma bicara ke Hyperdrive, Hyperdrive
# yang urus koneksi+pool beneran ke Aiven. ID-nya di-generate/di-refresh
# otomatis tiap deploy oleh deploy-worker.yml (`wrangler hyperdrive
# create/update`), BUKAN dibuat manual lewat dashboard.
[[hyperdrive]]
binding = "HYPERDRIVE"
id = "__HYPERDRIVE_ID__"
