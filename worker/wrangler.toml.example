name = "perseus-shelter-api"
main = "src/index.ts"
compatibility_date = "2025-01-01"
compatibility_flags = ["nodejs_compat"]

# Koneksi Postgres TIDAK lewat Hyperdrive -- Workers mendukung TCP socket
# langsung (nodejs_compat), jadi connect persis sama caranya kayak
# pipeline Python (lib/pg.py): host/user/password/database/CA cert, semua
# dari Worker Secrets (`wrangler secret put ...`), BUKAN dari file ini.
# Lihat deploy-worker.yml -- secret-nya dipakai ulang dari GitHub Secrets
# yang sama (PG_HOST dkk), gak ada kredensial baru yang perlu dibuat.
